// Test PNG dla obrazu statycznego.

let targetWidth = 100;

source "C:\\Users\\danie\\Downloads\\Tangiro.png";
sample every 1 frames;
fps 12;
set width = targetWidth;
set charset = "@%#*+=-:. ";
set fontName = "Consolas";
set fontSize = 16;
set invert = true;

filter grayscale;

export ascii to "..\\Exit\\tangiro.txt";
export json to "..\\Exit\\tangiro.json";
